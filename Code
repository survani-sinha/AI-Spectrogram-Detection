"""Difference between two methods"""

def cnn_packets(pred_row):
    n = int(np.clip(round(pred_row[ALL_OUT.index("NumBoxes")]), 2, MAX_BOXES))
    return sorted([pred_row[ALL_OUT.index(c)] for c in PACKET[:n]], reverse=True)

# pair up (true gray, estimated gray) for every packet, for each route
