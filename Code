"""## Method 1: **Classical Method**"""

def per_packet_gray(path, K=3, k=4.0, min_area=100 // 4): 
    # estimated brightness g of each detected packet, sorted brightest-first
    a = np.asarray(Image.open(path).convert("L").resize((128, 128)), dtype=np.float32) / 255.0
    bg = np.percentile(a, 95)
    d = bg - a                                       # darkness relative to background
    ds = ndimage.uniform_filter(d, K)                
    mu = np.median(ds); sg = 1.4826 * np.median(np.abs(ds - mu))
    m = ds > mu + k * sg
    m = ndimage.binary_closing(m, np.ones((5, 5)))
    m = ndimage.binary_opening(m, np.ones((3, 3)))
    lab, nl = ndimage.label(m)
    grays = []
    for i in range(1, nl + 1):
        comp = lab == i
        if comp.sum() < min_area:
            continue
        core = ndimage.binary_erosion(comp, np.ones((3, 3)))
        vals = d[core] if core.sum() > 10 else d[comp]
        grays.append(float(np.median(vals) / 0.3))
    return sorted(grays, reverse=True)               # brightest first to match the sorted labels

