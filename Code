IMG_SIZE = 128 

def load_gray(path):
    img = Image.open(path).convert("L").resize((IMG_SIZE, IMG_SIZE))
    return np.asarray(img, dtype=np.float32) / 255.0

class SpecDataset(Dataset):
    def __init__(self, frame, augment=False):
        vals = frame[ALL_OUT].values.astype(np.float32)
        self.y = ((vals - y_mean) / y_std).astype(np.float32)    # NaN stays NaN
        self.augment = augment
        self.imgs = [load_gray(p) for p in frame["path"]]

    def __len__(self):
        return len(self.imgs)

    def __getitem__(self, i):
        x = self.imgs[i]
        if self.augment:
            k = random.randint(0, 3)
            if k: x = np.rot90(x, k)
            if random.random() < 0.5: x = np.fliplr(x)
            if random.random() < 0.5: x = np.flipud(x)
            x = np.ascontiguousarray(x)
        x = (x - X_MEAN) / X_STD
        return torch.from_numpy(x).unsqueeze(0), torch.from_numpy(self.y[i])

train_ds, val_ds, test_ds = SpecDataset(train, True), SpecDataset(val), SpecDataset(test)
