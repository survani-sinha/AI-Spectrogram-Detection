    for k in range(min(len(truth), len(r2g))):
        cnn_pairs.append((truth[k], r2g[k]))
    r1g = per_packet_gray(r["path"])
    if len(r1g) == len(truth):                      # only where classical isolated every packet
        for a, b in zip(truth, r1g):
