@torch.no_grad()
def analyze(path):
    x = np.asarray(Image.open(path).convert("L").resize((128, 128)), dtype=np.float32) / 255.0
    xt = torch.from_numpy((x - X_MEAN) / X_STD).unsqueeze(0).unsqueeze(0).to(device)
    model.eval()
    out = model(xt).cpu().numpy()[0] * y_std + y_mean
    n = int(np.clip(round(out[ALL_OUT.index("NumBoxes")]), 2, MAX_BOXES))
    cnn_g = sorted([out[ALL_OUT.index(c)] for c in PACKET[:n]], reverse=True)
    return {
        "AvgGray": round(float(out[ALL_OUT.index("AvgGray")]), 3),
        "PackingDensity": round(float(out[ALL_OUT.index("PackingDensity")]), 3),
        "CNN per-packet gray": [round(v, 3) for v in cnn_g],
        "classical per-packet gray": [round(v, 3) for v in per_packet_gray(path)],
    }

row = test.iloc[0]
print(row["Filename"], f"({row['Difficulty']})")
for k, v in analyze(row["path"]).items():
