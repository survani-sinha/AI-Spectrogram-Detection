"""## Method 2: **CNN**"""

def block(cin, cout, k=3, n_convs=2):
    p = k // 2
    layers, c = [], cin
    for _ in range(n_convs):
        layers += [nn.Conv2d(c, cout, k, padding=p, bias=False),
                   nn.BatchNorm2d(cout), nn.ReLU(inplace=True)]
        c = cout
    layers.append(nn.MaxPool2d(2))
    return nn.Sequential(*layers)

class SpecNet(nn.Module):
    def __init__(self, n_out=len(ALL_OUT)):
        super().__init__()
        self.features = nn.Sequential(
            block(1,   32, k=7),    # 256 -> 128  large-kernel stem
            block(32,  64, k=5),    # 128 -> 64
            block(64,  96, k=5),    # 64  -> 32
            block(96,  128, k=3),   # 32  -> 16
            block(128, 128, k=3),   # 16  -> 8
            block(128, 128, k=3),   # 8   -> 4
        )
        self.pool = nn.AdaptiveAvgPool2d(2)
        self.head = nn.Sequential(
            nn.Flatten(), nn.Dropout(0.3),
            nn.Linear(128 * 2 * 2, 256), nn.ReLU(inplace=True),
            nn.Dropout(0.3),
            nn.Linear(256, n_out),
        )

    def forward(self, x):
        return self.head(self.pool(self.features(x)))

model = SpecNet().to(device)
n_layers = sum(1 for m in model.modules() if isinstance(m, (nn.Conv2d, nn.Linear)))
print(f"{n_layers} weight layers | {sum(p.numel() for p in model.parameters()):,} parameters")

loss_w = torch.tensor(LOSS_W, device=device, dtype=torch.float32)

def masked_smoothl1(pred, target, beta=0.5):
    valid = (~torch.isnan(target)).float()             
    t = torch.nan_to_num(target, nan=0.0)
    per = F.smooth_l1_loss(pred, t, beta=beta, reduction="none")
    per = per * valid * loss_w
    return per.sum() / (valid * loss_w).sum().clamp_min(1e-6)

"""Training"""

EPOCHS, PATIENCE, MAX_MINUTES = 400, 30, 90

optimizer = torch.optim.AdamW(model.parameters(), lr=1e-3, weight_decay=1e-4)
scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, "min", factor=0.5, patience=10)

def run_epoch(dl, train_mode):
    model.train(train_mode)
    total, n = 0.0, 0
    with torch.set_grad_enabled(train_mode):
        for xb, yb in dl:
            xb, yb = xb.to(device), yb.to(device)
            loss = masked_smoothl1(model(xb), yb)
            if train_mode:
                optimizer.zero_grad(); loss.backward(); optimizer.step()
            total += loss.item() * xb.size(0); n += xb.size(0)
    return total / n

history, best, best_epoch, best_state = [], float("inf"), 0, None
t0 = time.time()
for ep in range(1, EPOCHS + 1):
    tr, va = run_epoch(train_dl, True), run_epoch(val_dl, False)
    scheduler.step(va); history.append((tr, va))
    if va < best - 1e-5:
        best, best_epoch = va, ep
        best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}
    mins = (time.time() - t0) / 60
    print(f"ep {ep:3d}  train {tr:.4f}  val {va:.4f}  lr {optimizer.param_groups[0]['lr']:.1e}  ({mins:.1f} min)")
    if ep - best_epoch >= PATIENCE:
        print(f"early stop at {ep} (best {best_epoch})"); break
    if mins > MAX_MINUTES:
        print(f"hit {MAX_MINUTES} min budget at epoch {ep}"); break

model.load_state_dict(best_state)
print(f"restored epoch {best_epoch}, val loss {best:.4f}")

# training / validation loss curve
h = np.array(history)
plt.figure(figsize=(6, 4))
