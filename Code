plt.plot(h[:, 1], label="validation")
plt.axvline(best_epoch - 1, ls="--", c="k", lw=1, label=f"best (ep {best_epoch})")
plt.xlabel("epoch"); plt.ylabel("masked SmoothL1 (z-scored)")
plt.yscale("log"); plt.legend(); plt.title("Training curve")
plt.tight_layout(); plt.show()

"""Route 2 (CNN) Evaluation"""

@torch.no_grad()
def predict(dl):
    model.eval()
    ps, ys = [], []
    for xb, yb in dl:
        ps.append(model(xb.to(device)).cpu().numpy()); ys.append(yb.numpy())
    P = np.concatenate(ps) * y_std + y_mean
    Y = np.concatenate(ys) * y_std + y_mean
    return Y, P

def r2(y, p):
    y, p = np.asarray(y, float), np.asarray(p, float)
    return 1 - ((y - p) ** 2).sum() / ((y - y.mean()) ** 2).sum()

def report(Y, P, label=""):
    rows = []
    for i, t in enumerate(ALL_OUT):
        m = ~np.isnan(Y[:, i])
        e = Y[m, i] - P[m, i]
        rows.append({"output": t, "n": int(m.sum()), "MAE": np.abs(e).mean(),
                     "RMSE": np.sqrt((e ** 2).mean()), "R2": r2(Y[m, i], P[m, i])})
    print(f"--- {label} ---"); print(pd.DataFrame(rows).set_index("output").round(4)); print()

